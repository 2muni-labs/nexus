# Optional machine-local selectors. Copy to repos.env, which Git ignores.
# Find exact names/IDs with the selected Orca CLI's repo list --json.
# Bare names are normalized to name:<value>; name:, id:, path: work as-is.
# Literal double-quoted assignments only; no export, expansion, escapes,
# executable shell code, inline comments or credentials. Blank lines/comments allowed.
NEXUS_REPO_SELECTOR="name:nexus"
BASECAMP_REPO_SELECTOR="name:basecamp"
FOUNDRY_REPO_SELECTOR="name:foundry"
